# Release artifacts (wheel AND sdist) ship only the package code and the runtime assets
# listed under [tool.setuptools.package-data] in pyproject.toml (the trained models
# brainmaze_torch/seizure_detection/_models/*.pt, which must stay) -- no tests, demos,
# docs, images or other data (maintainer rule). Do not add *.pt to the excludes below.
# The family CI checks this on every PR (dist-check).
prune tests
prune docs_src
prune img
prune .github
exclude make_docs.sh RELEASING.md .gitignore
global-exclude *.npz *.npy *.mat *.edf *.csv *.xml *.pkl *.h5
global-exclude *.py[cod]
